{
  "buildCommand": "corepack yarn build",
  "installCommand": "corepack yarn install --immutable --mode=skip-build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/images/social-share",
      "destination": "/images/social-share.png"
    },
    {
      "source": "/components/:path*",
      "destination": "/index.html"
    }
  ]
}
